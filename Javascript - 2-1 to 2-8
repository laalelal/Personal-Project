const CONFIG = {
    MAX_SALARY: 10000000,
    MIN_SALARY: 100000,
    REQUIRED_FIELDS: [
        "firstName",
        "lastName",
        "email",
        "department"
    ],
    EMAIL_PATTERN: /^[^\s@]+@[^\s@]+\.[^\s@]+$/
};

function validateEmployeeData(employee) {
    const errors = [];
    const warnings = [];

    // Required field validation
    for (const field of CONFIG.REQUIRED_FIELDS) {
        if (
            employee[field] === undefined ||
            employee[field] === null ||
            String(employee[field]).trim() === ""
        ) {
            errors.push(`${field} is required`);
        }
    }

    // Email validation
    if (
        employee.email !== undefined &&
        String(employee.email).trim() !== "" &&
        !CONFIG.EMAIL_PATTERN.test(String(employee.email).trim())
    ) {
        errors.push("Invalid email format");
    }

    // Salary validation
    if (employee.salary !== undefined && employee.salary !== null) {
        const salary = Number(employee.salary);

        if (Number.isNaN(salary)) {
            errors.push("Salary must be a valid number");
        } else {
            if (salary < CONFIG.MIN_SALARY) {
                warnings.push(
                    `Salary is below minimum ${CONFIG.MIN_SALARY}`
                );
            }

            if (salary > CONFIG.MAX_SALARY) {
                errors.push(
                    `Salary exceeds maximum ${CONFIG.MAX_SALARY}`
                );
            }
        }
    }

    return {
        isValid: errors.length === 0,
        errors,
        warnings
    };
}



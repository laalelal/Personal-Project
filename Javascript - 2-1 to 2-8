class Employee {

    constructor(
        id,
        firstName,
        lastName,
        department,
        salary,
        joiningDate
    ) {

        this.id = id;
        this.firstName = firstName;
        this.lastName = lastName;
        this.department = department;
        this.salary = salary;

        this.joiningDate =
            joiningDate instanceof Date
                ? joiningDate
                : new Date(joiningDate);

        this.createdAt = new Date();
        this.updatedAt = new Date();
    }


    get fullName() {

        return (
            `${this.firstName} ${this.lastName}`
        ).trim();
    }


    set fullName(value) {

        const parts =
            String(value)
                .trim()
                .split(/\s+/);

        if (parts.length < 2) {
            throw new Error(
                "Full name must contain at least two name parts"
            );
        }

        this.firstName = parts[0];

        this.lastName =
            parts.slice(1).join(" ");

        this.updatedAt = new Date();
    }


    getYearsOfService() {

        return calculateYearsOfService(
            this.joiningDate
        );
    }


    giveIncrement(percent) {

        if (
            typeof percent !== "number" ||
            percent <= 0
        ) {
            throw new Error(
                "Increment must be greater than 0"
            );
        }

        if (percent > 50) {
            throw new Error(
                "Increment cannot exceed 50%"
            );
        }

        this.salary +=
            this.salary * percent / 100;

        this.updatedAt = new Date();

        return this.salary;
    }


    toXML() {

        return `
<Employee>
    <id>${this.id}</id>
    <firstName>${this.firstName}</firstName>
    <lastName>${this.lastName}</lastName>
    <department>${this.department}</department>
    <salary>${this.salary}</salary>
    <joiningDate>${this.joiningDate.toISOString()}</joiningDate>
</Employee>`.trim();
    }


    toJSON() {

        return {
            id: this.id,
            firstName: this.firstName,
            lastName: this.lastName,
            fullName: this.fullName,
            department: this.department,
            salary: this.salary,
            joiningDate:
                this.joiningDate.toISOString(),
            createdAt:
                this.createdAt.toISOString(),
            updatedAt:
                this.updatedAt.toISOString()
        };
    }


    static fromXML(xml) {

        function getValue(tag) {

            const regex =
                new RegExp(
                    `<${tag}>(.*?)</${tag}>`
                );

            const match =
                xml.match(regex);

            return match
                ? match[1]
                : "";
        }

        return new Employee(
            getValue("id"),
            getValue("firstName"),
            getValue("lastName"),
            getValue("department"),
            Number(getValue("salary")),
            getValue("joiningDate")
        );
    }
}



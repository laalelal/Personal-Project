// Years of service
function calculateYearsOfService(date) {
    const today = new Date();

    let years =
        today.getFullYear() -
        date.getFullYear();

    const monthDifference =
        today.getMonth() -
        date.getMonth();

    if (
        monthDifference < 0 ||
        (
            monthDifference === 0 &&
            today.getDate() < date.getDate()
        )
    ) {
        years--;
    }

    return years;
}

